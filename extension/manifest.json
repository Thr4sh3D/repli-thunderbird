{
  "manifest_version": 2,
  "name": "Repli",
  "version": "1.0",
  "description": "Min AI assistent",
  "permissions": [
    "messagesRead",
    "messagesModify",
    "accountsRead",
    "menus",
    "notifications",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "repli@tobias.local",
      "strict_min_version": "78.0"
    }
  }
}